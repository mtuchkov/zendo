%YAML 1.2
---
# A small TOML syntax: syntect ships none. zendo adds it to the syntaxes it ships.
name: TOML
file_extensions: [toml]
scope: source.toml
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.toml
    - match: '^\s*\[\[?[^\]]*\]\]?'
      scope: entity.name.section.toml
    - match: '^\s*([A-Za-z0-9_.-]+|"[^"]*")\s*(?==)'
      captures:
        1: entity.other.attribute-name.toml
    - match: '"""'
      push: triple
    - match: '"'
      push: double
    - match: "'[^']*'"
      scope: string.quoted.single.toml
    - match: '\b(true|false)\b'
      scope: constant.language.toml
    - match: '(?<![\w.-])[+-]?\d[\d_]*(\.\d+)?([eE][+-]?\d+)?\b'
      scope: constant.numeric.toml
  double:
    - meta_scope: string.quoted.double.toml
    - match: '\\.'
    - match: '"'
      pop: true
  triple:
    - meta_scope: string.quoted.triple.toml
    - match: '"""'
      pop: true
